PORT=5000
NODE_ENV=development

# Must equal the deployed Next.js client URL.
# Used for CORS and for the Better Auth JWKS endpoint:
#   <CLIENT_URL>/api/auth/jwks
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/pizzahub

# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_PREMIUM_PRICE_ID=price_placeholder

# ImgBB
IMGBB_API_KEY=placeholder_imgbb_api_key

# Admin promotion script (npm run create-admin)
# The user must already exist — sign up through the website first.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=System Administrator

# Seed script — set to emails of users who have already signed up
SEED_ADMIN_EMAIL=admin@example.com
SEED_VENDOR1_EMAIL=vendor1@example.com
SEED_VENDOR2_EMAIL=vendor2@example.com
SEED_CUSTOMER_EMAIL=customer@example.com
